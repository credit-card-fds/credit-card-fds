# 1. 파이썬 컴파일 & 가상환경
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# 2. 에디터 및 개발 환경 (VS Code, PyCharm, OS)
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# 3. 주피터 노트북 캐시
.ipynb_checkpoints

# 4. 데이터셋·결과물 (CSV는 크기와 상관없이 Git에 올리지 않음, 노트북 실행으로 생성)
*.csv
reports/figures/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 5. 모델 가중치 및 대용량 아티팩트
*.pkl
*.h5
*.joblib
*.pth
*.onnx

# 6. 로그 및 기타 임시 파일
*.log
.pytest_cache/